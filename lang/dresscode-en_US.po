msgstr "Name"

msgid "名称不能为空。"
msgstr "The name cannot be empty."

msgid "在 open.bigmodel.cn 获取的 API Key，以密码框掩码显示；如需更换直接覆盖。"
msgstr "API key from open.bigmodel.cn, shown masked in a password field; overwrite it to replace."

msgid "如 glm-4.6、glm-4.5、glm-4-plus 等，按账号可用模型填写。"
msgstr "e.g. glm-4.6, glm-4.5, glm-4-plus — use a model available to your account."

msgid "完整端点 URL。OpenAI 格式如 https://open.bigmodel.cn/api/paas/v4/chat/completions；Anthropic 格式如 https://your-relay.com/v1/messages。"
msgstr "Full endpoint URL. OpenAI format e.g. https://open.bigmodel.cn/api/paas/v4/chat/completions; Anthropic format e.g. https://your-relay.com/v1/messages."

msgid "按服务商选择：OpenAI 兼容（chat/completions）或 Anthropic Messages（/v1/messages）。"
msgstr "Choose per your provider: OpenAI-compatible (chat/completions) or Anthropic Messages (/v1/messages)."

