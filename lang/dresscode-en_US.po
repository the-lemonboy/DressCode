msgstr "OpenAI and Anthropic formats use this full endpoint URL. GLM Coding Plan automatically uses https://open.bigmodel.cn/api/coding/paas/v4/chat/completions."

msgid "SKILL.md（System Prompt）"
msgstr "SKILL.md (System Prompt)"

msgid "Settings"
msgstr "Settings"

msgid "Skill"
msgstr "Skill"

